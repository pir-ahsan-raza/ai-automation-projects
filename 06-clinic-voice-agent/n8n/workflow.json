    {
      "parameters": {
        "jsCode": "const input = $('Parse Event').first().json;\nconst params = input.functionParams || {};\n\n// Use provided number or fall back to caller ID\nlet raw = (params.patientPhone || '').trim();\nif (!raw || raw === 'unknown') {\n  raw = input.callerNumber || '';\n}\n\n// Strip everything except digits and leading +\nlet digits = raw.replace(/[^0-9+]/g, '');\n\n// Pakistani local 0300xxxxxxx (11 digits) → +92300xxxxxxx\nif (digits.startsWith('0') && digits.length === 11) {\n  digits = '+92' + digits.slice(1);\n} else if (digits.length > 0 && !digits.startsWith('+')) {\n  digits = '+' + digits;\n}\n\nreturn [{ json: {\n  patientName:  params.patientName,\n  patientPhone: digits,\n  date:         params.date,\n  time:         params.time,\n  reason:       params.reason,\n  doctorName:   params.doctorName || 'Next Available',\n  timestamp:    input.timestamp,\n  callId:       input.callId\n}}];"
      },
