    {
      "parameters": {
        "jsCode": "const input = $('Parse Event').first().json;\nconst params = input.functionParams || {};\nconst date = params.date || '';\nconst time = params.time || '';\n\nconst items = $input.all();\nconst conflict = items.find(r =>\n  r.json?.date === date &&\n  r.json?.time === time &&\n  r.json?.status === 'confirmed'\n);\n\nif (conflict) {\n  return [{ json: {\n    slotAvailable: false,\n    conflict: true,\n    message: `${time} on ${date} was just booked. Please choose another time.`,\n    ...params,\n    timestamp: input.timestamp,\n    callId: input.callId\n  }}];\n}\n\nreturn [{ json: {\n  slotAvailable: true,\n  conflict: false,\n  ...params,\n  timestamp: input.timestamp,\n  callId: input.callId\n}}];"
      },
      "type": "n8n-nodes-base.code",
