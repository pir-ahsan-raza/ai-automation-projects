    {
      "parameters": {
        "jsCode": "const today = new Date();\n\nfunction toYMD(d) {\n  return d.toISOString().split('T')[0];\n}\n\nfunction getNextWeekday(targetDay) {\n  const d = new Date(today);\n  let diff = targetDay - d.getDay();\n  if (diff <= 0) diff += 7;\n  d.setDate(d.getDate() + diff);\n  return toYMD(d);\n}\n\nfunction getNextWorkday() {\n  const d = new Date(today);\n  d.setDate(d.getDate() + 1);\n  while (d.getDay() === 0 || d.getDay() === 6) {\n    d.setDate(d.getDate() + 1);\n  }\n  return toYMD(d);\n}\n\nconst hour = today.getHours();\nconst dow = today.getDay();\nlet isOpen = false;\nif (dow >= 1 && dow <= 5 && hour >= 9 && hour < 17) isOpen = true;\nif (dow === 6 && hour >= 10 && hour < 14) isOpen = true;\n\nconst dateMap = {\n  monday:    getNextWeekday(1),\n  tuesday:   getNextWeekday(2),\n  wednesday: getNextWeekday(3),\n  thursday:  getNextWeekday(4),\n  friday:    getNextWeekday(5),\n  tomorrow:  getNextWorkday(),\n  asap:      getNextWorkday(),\n  anytime:   getNextWorkday()\n};\n\nconst input = $input.first().json;\nreturn [{ json: {\n  ...input,\n  dateMap,\n  isOpen,\n  todayStr: toYMD(today),\n  nextAvailableDate: getNextWorkday()\n}}];"
      },
