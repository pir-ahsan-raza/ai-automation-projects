      "parameters": {
        "jsCode": "const toolCallId = $('Parse Event').first().json.toolCallId || '';\nconst result = $('Calculate Slots').first().json.result || 'No slots available.';\nconst response = JSON.stringify({\n  results: [{ toolCallId, result }]\n});\nreturn [{ json: { response } }];"
      },
