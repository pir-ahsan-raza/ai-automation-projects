    {
      "parameters": {
        "jsCode": "const params = $('Parse Event').first().json.functionParams || {};\nlet date = params.preferredDate || params.date || '';\n\nconst today = new Date();\nfunction toYMD(d) { return d.toISOString().split('T')[0]; }\nfunction getNextWeekday(t) {\n  const d = new Date(today);\n  let diff = t - d.getDay();\n  if (diff <= 0) diff += 7;\n  d.setDate(d.getDate() + diff);\n  return toYMD(d);\n}\nfunction getNextWorkday() {\n  const d = new Date(today);\n  d.setDate(d.getDate() + 1);\n  while (d.getDay() === 0 || d.getDay() === 6) d.setDate(d.getDate() + 1);\n  return toYMD(d);\n}\n\nconst lower = date.toLowerCase().trim();\nif (lower === 'monday')         date = getNextWeekday(1);\nelse if (lower === 'tuesday')   date = getNextWeekday(2);\nelse if (lower === 'wednesday') date = getNextWeekday(3);\nelse if (lower === 'thursday')  date = getNextWeekday(4);\nelse if (lower === 'friday')    date = getNextWeekday(5);\nelse if (['asap','anytime','tomorrow',''].includes(lower)) date = getNextWorkday();\n\nlet items = [];\ntry {\n  items = $input.all().filter(i => i.json?.date && i.json.date.trim() !== '');\n} catch(e) {}\n\nconst booked = items\n  .filter(r => r.json.date === date && r.json.status !== 'cancelled')\n  .map(r => r.json.time);\n\nconst all = [];\nfor (let h = 9; h < 17; h++) {\n  all.push(`${String(h).padStart(2,'0')}:00`);\n  all.push(`${String(h).padStart(2,'0')}:30`);\n}\nconst free = all.filter(s => !booked.includes(s));\n\nconst result = free.length > 0\n  ? `Available slots on ${date}: ${free.slice(0, 6).join(', ')}.`\n  : `No slots on ${date}.`;\n\nreturn [{ json: { result, available: free, date } }];"
      },
