      "parameters": {
        "jsCode": "const body = $input.first().json.body || $input.first().json;\nconst msg = body.message || body;\nconst call = msg.call || {};\n\nlet functionName = null;\nlet functionParams = {};\nlet toolCallId = null;\n\nif (msg.type === 'tool-calls' && msg.toolCallList && msg.toolCallList.length > 0) {\n  const tc = msg.toolCallList[0];\n  functionName = tc.function?.name || null;\n  toolCallId = tc.id || null;\n  try {\n    functionParams = typeof tc.function?.arguments === 'string'\n      ? JSON.parse(tc.function.arguments)\n      : (tc.function?.arguments || {});\n  } catch(e) { functionParams = {}; }\n} else if (msg.type === 'function-call' && msg.functionCall) {\n  functionName = msg.functionCall.name || null;\n  functionParams = msg.functionCall.parameters || {};\n}\n\nconst rawType = msg.type || 'unknown';\nconst eventType = (rawType === 'tool-calls') ? 'function-call' : rawType;\n\nreturn [{ json: {\n  eventType,\n  rawType,\n  callId:        call.id || ('call_' + Date.now()),\n  callerNumber:  call.customer?.number || call.phoneNumber?.number || 'unknown',\n  functionName,\n  functionParams,\n  toolCallId,\n  endedReason:   msg.endedReason || null,\n  durationSecs:  msg.durationSeconds || 0,\n  summary:       msg.summary || null,\n  timestamp:     new Date().toISOString()\n}}];"
      },
      "id": "4d7ae299-ff64-453b-81ac-b9bf6f8b5e79",
